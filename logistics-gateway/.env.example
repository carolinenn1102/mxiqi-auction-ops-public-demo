SF_CLIENT_CODE=
SF_CHECK_WORD=
SF_MONTHLY_CARD=
SF_EXPRESS_TYPE_ID=
# 1 寄方付；2 收方付；3 第三方付。必须按与顺丰签约的实际方式填写。
SF_PAY_METHOD=
SF_PICKUP_LEAD_HOURS=5
SF_PICKUP_LATEST_HOUR=22
SF_NEXT_DAY_PICKUP_HOUR=10
