{
  "manifest_version": 3,
  "name": "麦稀奇采集助手",
  "version": "1.8.0",
  "description": "从送拍业务工作台安全登录麦稀奇、同步授权订单，并承接真实物流配置。",
  "key": "",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["https://www.mxiqi.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.mxiqi.com/*"],
      "js": ["mxiqi-parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://carolinenn1102.github.io/mxiqi-auction-ops-public-demo/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "action": {
    "default_title": "麦稀奇采集助手"
  }
}
